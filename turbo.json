{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "tasks": {
        "topo": {
            "dependsOn": ["^topo"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".cache/tsbuildinfo.json", "dist/**"]
        },
        "dev": {
            "dependsOn": ["^dev"],
            "cache": false,
            "persistent": false
        },
        "format": {
            "outputs": [".cache/.prettiercache"],
            "outputLogs": "new-only"
        },
        "lint": {
            "dependsOn": ["^topo", "^build"],
            "outputs": [".cache/.eslintcache"]
        },
        "typecheck": {
            "dependsOn": ["^topo", "^build"],
            "outputs": [".cache/tsbuildinfo.json"]
        },
        "test": {
            "dependsOn": ["^topo", "^build"]
        },
        "clean": {
            "cache": false
        },
        "//#clean": {
            "cache": false
        },
        "ui-add": {
            "cache": false,
            "interactive": true
        }
    },
    "globalEnv": [
        "AUTH_SECRET",
        "AUTH_PROTOCOL",
        "API_URL",
        "API_KEY",
        "ALLOWED_ORIGINS",
        "IMAGE_PROVIDERS",
        "PORT"
    ],
    "globalPassThroughEnv": [
        "NODE_ENV",
        "CI",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_URL",
        "npm_lifecycle_event"
    ]
}
