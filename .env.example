# Since .env is gitignored, use this file as the template for your own `.env`.
# Keep it up-to-date when you add new variables. It IS committed, so no secrets here.

# ---------------------------------------------------------------------------
# Backend REST API
# ---------------------------------------------------------------------------
# Base URL of the "te inscreve" REST API. Every tRPC procedure proxies to it —
# there is no database connection anywhere in this monorepo.
API_URL='http://localhost:8080'

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs/encrypts the better-auth session cookie. better-auth runs in STATELESS
# mode (no database): the session — including the JWT issued by the REST API —
# lives entirely inside this cookie, so this secret is what makes it tamper-proof.
# Generate with: openssl rand -base64 32
AUTH_SECRET='supersecret-change-me-min-32-chars-long'
