{
    "name": "te-inscreve-frontend",
    "private": true,
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "yarn@4.18.0",
    "workspaces": [
        "apps/*",
        "packages/*",
        "tooling/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "clean": "git clean -xdf node_modules .yarn/cache",
        "clean:workspaces": "turbo run clean",
        "dev": "turbo watch dev --continue",
        "dev:next": "turbo watch dev -F @te-inscreve/nextjs...",
        "dev:expo": "turbo watch dev -F @te-inscreve/expo...",
        "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
        "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
        "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
        "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "ui-add": "turbo run ui-add",
        "android": "yarn workspace @te-inscreve/expo android",
        "ios": "yarn workspace @te-inscreve/expo ios"
    },
    "resolutions": {
        "lightningcss": "1.30.1"
    },
    "devDependencies": {
        "@te-inscreve/prettier-config": "workspace:*",
        "dotenv-cli": "^11.0.0",
        "prettier": "^3.6.2",
        "turbo": "^2.10.7",
        "typescript": "~6.0.3"
    },
    "prettier": "@te-inscreve/prettier-config"
}
