{
    "name": "@te-inscreve/nextjs",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build": "yarn with-env next build",
        "clean": "git clean -xdf .cache .next .turbo node_modules",
        "dev": "yarn with-env next dev",
        "format": "prettier --check . --ignore-path ../../.gitignore",
        "lint": "eslint",
        "start": "yarn with-env next start",
        "typecheck": "tsc --noEmit",
        "with-env": "dotenv -e ../../.env --"
    },
    "dependencies": {
        "@t3-oss/env-nextjs": "^0.13.11",
        "@tanstack/react-query": "^5.101.4",
        "@te-inscreve/api": "workspace:*",
        "@te-inscreve/auth": "workspace:*",
        "@te-inscreve/rest": "workspace:*",
        "@te-inscreve/ui": "workspace:*",
        "@te-inscreve/validators": "workspace:*",
        "@trpc/client": "^11.18.0",
        "@trpc/server": "^11.18.0",
        "@trpc/tanstack-react-query": "^11.18.0",
        "better-auth": "^1.6.25",
        "next": "^16.2.12",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "superjson": "^2.2.6",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@te-inscreve/eslint-config": "workspace:*",
        "@te-inscreve/prettier-config": "workspace:*",
        "@te-inscreve/tailwind-config": "workspace:*",
        "@te-inscreve/tsconfig": "workspace:*",
        "@types/node": "^22.18.12",
        "@types/react": "~19.2.0",
        "@types/react-dom": "~19.2.0",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.38.0",
        "jiti": "^2.7.0",
        "prettier": "^3.6.2",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3"
    },
    "prettier": "@te-inscreve/prettier-config"
}
