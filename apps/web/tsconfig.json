{
    "extends": "@te-inscreve/tsconfig/base.json",
    "compilerOptions": {
        "lib": ["ES2022", "dom", "dom.iterable"],
        "jsx": "preserve",
        "paths": {
            "~/*": ["./src/*"],
            "@/public/*": ["./public/*"]
        },
        "plugins": [{ "name": "next" }]
    },
    "include": [".", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
}
