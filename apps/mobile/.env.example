# Copie para .env. EXPO_PUBLIC_* vai embutido no bundle: nada de segredo aqui.

# Endereço do BFF Next.js. Obrigatório no build release, que não tem o Metro
# para descobrir o IP da máquina; em desenvolvimento o IP do Metro tem prioridade.
# Com http://, o release passa a aceitar HTTP sem TLS (ver app.config.ts).
EXPO_PUBLIC_BFF_URL=http://192.168.0.10:3000
