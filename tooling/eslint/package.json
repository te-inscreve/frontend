{
    "name": "@te-inscreve/eslint-config",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "exports": {
        "./base": "./base.ts",
        "./nextjs": "./nextjs.ts",
        "./react": "./react.ts"
