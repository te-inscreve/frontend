        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-turbo": "^2.10.7",
        "typescript-eslint": "^8.46.2"
    },
    "devDependencies": {
        "@te-inscreve/prettier-config": "workspace:*",
        "@te-inscreve/tsconfig": "workspace:*",
        "@types/node": "^22.18.12",
        "eslint": "^9.38.0",
        "prettier": "^3.6.2",
        "turbo": "^2.10.7",
        "typescript": "~6.0.3"
    },
    "prettier": "@te-inscreve/prettier-config"
