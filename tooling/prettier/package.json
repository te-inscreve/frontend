{
    "name": "@te-inscreve/prettier-config",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": "./index.js"
    },
    "scripts": {
        "clean": "git clean -xdf .cache .turbo node_modules",
