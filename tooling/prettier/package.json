    "dependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.7.1"
    },
    "devDependencies": {
        "@te-inscreve/tsconfig": "workspace:*",
        "@types/node": "^22.18.12",
        "typescript": "~5.9.3"
    },
    "prettier": "@te-inscreve/prettier-config"
}
