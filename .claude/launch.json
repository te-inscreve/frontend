{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "web",
            "runtimeExecutable": "yarn",
            "runtimeArgs": ["workspace", "@te-inscreve/nextjs", "dev"],
            "port": 3000,
            "autoPort": false
        },
        {
            "name": "web-attach",
            "url": "http://localhost:3000",
            "port": 3000
        },
        {
            "name": "mobile",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "workspace",
                "@te-inscreve/expo",
                "expo",
                "start",
                "--clear",
                "--port",
                "8082",
                "--lan"
            ],
            "port": 8082,
            "autoPort": false
        }
    ]
}
