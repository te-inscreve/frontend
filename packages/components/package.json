{
    "name": "@te-inscreve/components",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./shadcn.css": "./src/shadcn.css",
        "./utils": "./src/utils.ts",
        "./components/*": "./src/components/*.tsx",
        "./alert-dialog": "./src/components/alert-dialog.tsx",
        "./badge": "./src/components/badge.tsx",
        "./breadcrumb": "./src/components/breadcrumb.tsx",
        "./button": "./src/components/button.tsx",
        "./calendar": "./src/components/calendar.tsx",
        "./card": "./src/components/card.tsx",
        "./checkbox": "./src/components/checkbox.tsx",
        "./collapsible": "./src/components/collapsible.tsx",
        "./dialog": "./src/components/dialog.tsx",
        "./input": "./src/components/input.tsx",
        "./field": "./src/components/field.tsx",
        "./label": "./src/components/label.tsx",
        "./popover": "./src/components/popover.tsx",
        "./switch": "./src/components/switch.tsx",
        "./tabs": "./src/components/tabs.tsx",
        "./textarea": "./src/components/textarea.tsx",
        "./sheet": "./src/components/sheet.tsx",
        "./tooltip": "./src/components/tooltip.tsx",
        "./skeleton": "./src/components/skeleton.tsx",
        "./scroll-area": "./src/components/scroll-area.tsx",
        "./select": "./src/components/select.tsx",
        "./separator": "./src/components/separator.tsx",
        "./dropdown-menu": "./src/components/dropdown-menu.tsx",
        "./hooks": "./src/hooks/use-mobile.ts"
    },
    "license": "MIT",
    "scripts": {
        "clean": "git clean -xdf .cache .turbo dist node_modules",
        "format": "prettier --check . --ignore-path ../../.gitignore",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "ui-add": "yarn dlx shadcn@latest add && prettier src --write --list-different"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "class-variance-authority": "^0.7.1",
        "radix-ui": "^1.4.3",
        "react-day-picker": "^10.0.1",
        "react-hook-form": "^7.85.0",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@te-inscreve/eslint-config": "workspace:*",
        "@te-inscreve/prettier-config": "workspace:*",
        "@te-inscreve/tsconfig": "workspace:*",
        "@types/react": "~19.2.0",
        "eslint": "^9.38.0",
        "prettier": "^3.6.2",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "shadcn": "^4.16.1",
        "typescript": "~5.9.3"
    },
    "peerDependencies": {
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "prettier": "@te-inscreve/prettier-config"
}
