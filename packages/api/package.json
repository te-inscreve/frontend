{
    "name": "@te-inscreve/api",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./src/index.ts"
        }
    },
    "license": "MIT",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean": "git clean -xdf .cache .turbo dist node_modules",
        "dev": "tsc -p tsconfig.build.json",
        "format": "prettier --check . --ignore-path ../../.gitignore",
        "lint": "eslint",
        "typecheck": "tsc --noEmit --emitDeclarationOnly false"
    },
    "dependencies": {
        "@te-inscreve/auth": "workspace:*",
        "@te-inscreve/rest": "workspace:*",
        "@te-inscreve/schemas": "workspace:*",
        "@trpc/server": "^11.18.0",
        "superjson": "^2.2.6",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@te-inscreve/eslint-config": "workspace:*",
        "@te-inscreve/prettier-config": "workspace:*",
        "@te-inscreve/tsconfig": "workspace:*",
        "eslint": "^9.38.0",
        "prettier": "^3.6.2",
        "typescript": "~6.0.3"
    },
    "prettier": "@te-inscreve/prettier-config"
}
